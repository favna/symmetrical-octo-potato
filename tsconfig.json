{
  "compilerOptions": {
    "rootDir": "src",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "alwaysStrict": true,
    "esModuleInterop": true,
    "declaration": true,
    "lib": ["esnext"],
    "target": "es2024",
    "module": "node20",
    "moduleResolution": "node16",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src"]
}
